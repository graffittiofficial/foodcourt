<% content_for :title, "#{@report.category.humanize} report | Foodcourt" %>
<section class="max-w-3xl space-y-5 rounded-xl border border-stone-200 bg-white p-6">
  <h1 class="text-3xl font-bold"><%= @report.category.humanize %> report</h1>
  <dl class="grid gap-3 sm:grid-cols-2">
    <div><dt class="font-semibold">Scope</dt><dd><%= @report.restaurant ? "#{@report.organization.name} / #{@report.restaurant.name}" : @report.organization.name %></dd></div>
    <div><dt class="font-semibold">Date range</dt><dd><%= @report.start_date %> – <%= @report.end_date %></dd></div>
    <div><dt class="font-semibold">Requested</dt><dd><%= l(@report.created_at, format: :long) %></dd></div>
    <div><dt class="font-semibold">Status</dt><dd><%= @report.status.humanize %></dd></div>
  </dl>
  <% if @report.failed? %><p class="rounded-lg bg-red-50 p-3 text-red-800" role="alert"><%= @report.error_message.presence || "Report generation failed." %></p><% end %>
  <% if @report.completed? && @report.file.attached? %>
    <%= link_to "Download CSV", download_report_path(@report), class: "inline-flex rounded-lg bg-stone-950 px-4 py-2 font-semibold text-white" %>
    <p class="text-sm text-stone-600">Available until <%= l(@report.expires_at, format: :long) %>.</p>
  <% end %>
  <%= link_to "Back to reports", reports_path, class: "block underline" %>
</section>
