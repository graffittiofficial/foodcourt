<% content_for :title, "Foodcourt | Order from local restaurants" %>
<div class="mb-10 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-orange-700">Good food, all in one place</p>
    <h1 class="mt-2 text-4xl font-bold text-stone-900">Choose a restaurant</h1>
    <p class="mt-3 max-w-2xl text-stone-600">Browse menus from local restaurants and build one basket for delivery.</p>
  </div>
  <%= link_to "View basket", cart_path, class: "rounded-lg bg-orange-600 px-4 py-2.5 font-semibold text-white hover:bg-orange-700" %>
</div>

<%= render "restaurants/list", restaurants: @restaurants %>
