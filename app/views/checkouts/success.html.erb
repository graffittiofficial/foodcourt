<% content_for :title, "Order confirmation | Foodcourt" %>
<h1 class="text-3xl font-bold text-stone-900">Payment confirmation</h1>
<% if @checkout.pending? %>
  <p class="mt-3 rounded-lg bg-amber-50 p-4 text-amber-900" role="status">Your payment is being confirmed. This page will show your restaurant orders once confirmation arrives.</p>
<% elsif @checkout.expired? %>
  <p class="mt-3 rounded-lg bg-red-50 p-4 text-red-800" role="alert">This checkout expired before payment was completed. Your basket is still available.</p>
  <%= link_to "Return to your basket", cart_path, class: "mt-5 inline-block font-semibold text-orange-700 underline" %>
<% else %>
  <p class="mt-3 text-stone-600">Your payment was received. Each restaurant is preparing its own order for delivery.</p>
  <ul class="mt-6 space-y-4">
    <% @checkout.checkout_groups.each do |group| %>
      <% if group.order %>
        <li class="rounded-xl border border-stone-200 bg-white p-5">
          <h2 class="font-bold text-stone-900"><%= group.restaurant.name %></h2>
          <%= link_to "Track order ##{group.order.id}", order_path(group.order), class: "mt-2 inline-block font-semibold text-orange-700 underline" %>
        </li>
      <% end %>
    <% end %>
  </ul>
  <%= link_to "View all orders", orders_path, class: "mt-6 inline-block rounded-lg bg-orange-600 px-4 py-2.5 font-semibold text-white" %>
<% end %>
