<% content_for :title, "Checkout | Foodcourt" %>
<div class="mb-8">
  <%= link_to "← Back to basket", cart_path, class: "text-sm font-semibold text-stone-500 hover:text-stone-950" %>
  <h1 class="mt-3 text-3xl font-bold tracking-tight text-stone-950 sm:text-4xl">Delivery details</h1>
  <ol class="mt-5 flex max-w-xl items-center gap-3 text-sm" aria-label="Checkout progress">
    <li class="flex items-center gap-2 font-semibold text-stone-950"><span class="flex size-7 items-center justify-center rounded-full bg-stone-950 text-xs text-white">1</span> Delivery</li>
    <li class="h-px flex-1 bg-stone-300"></li>
    <li class="flex items-center gap-2 text-stone-400"><span class="flex size-7 items-center justify-center rounded-full border border-stone-300 text-xs">2</span> Payment</li>
  </ol>
</div>

<% if @entries.empty? %>
  <p class="rounded-2xl border border-dashed border-stone-300 bg-white p-8 text-center text-stone-600">Your basket is empty. <%= link_to "Browse restaurants", restaurants_path, class: "font-semibold text-stone-950 underline" %></p>
<% else %>
  <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <%= form_with scope: :checkout, url: checkouts_path, data: { controller: "address-autocomplete", address_autocomplete_api_key_value: ENV["GOOGLE_MAPS_BROWSER_API_KEY"] }, class: "space-y-5" do |form| %>
      <section class="space-y-4 rounded-3xl border border-stone-200 bg-white p-6 sm:p-8">
        <div>
          <h2 class="text-xl font-bold text-stone-950">Contact information</h2>
          <p class="mt-1 text-sm text-stone-500">We’ll use this if the courier needs to reach you.</p>
        </div>
        <div>
          <%= form.label :customer_name, "Recipient name", class: "mb-1.5 block text-sm font-semibold text-stone-800" %>
          <%= form.text_field :customer_name, value: @customer_name, required: true, autocomplete: "name", class: "w-full rounded-xl border border-stone-300 px-4 py-3 focus:border-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-200" %>
        </div>
        <div>
          <%= form.label :customer_phone, "Contact phone", class: "mb-1.5 block text-sm font-semibold text-stone-800" %>
          <%= form.telephone_field :customer_phone, required: true, autocomplete: "tel", class: "w-full rounded-xl border border-stone-300 px-4 py-3 focus:border-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-200" %>
        </div>
      </section>

      <section class="space-y-4 rounded-3xl border border-stone-200 bg-white p-6 sm:p-8">
        <div>
          <h2 class="text-xl font-bold text-stone-950">Delivery address</h2>
          <p class="mt-1 text-sm text-stone-500">Choose a suggested address so we can confirm delivery availability.</p>
        </div>
        <% if ENV["GOOGLE_MAPS_BROWSER_API_KEY"].blank? %>
          <p class="rounded-xl bg-amber-50 p-4 text-sm text-amber-900" role="alert">Address autocomplete is not configured. Contact the site administrator before placing this order.</p>
        <% else %>
          <%= text_field_tag :delivery_address_search, nil, id: "delivery-address-search", placeholder: "Search for your delivery address", autocomplete: "off", class: "w-full rounded-xl border border-stone-300 px-4 py-3 focus:border-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-200", data: { address_autocomplete_target: "input" } %>
        <% end %>
        <%= form.hidden_field :google_place_id, required: true, data: { address_autocomplete_target: "placeId" } %>
        <div>
          <%= form.label :address_line2, "Apartment, suite, or unit (optional)", class: "mb-1.5 block text-sm font-semibold text-stone-800" %>
          <%= form.text_field :address_line2, autocomplete: "address-line2", class: "w-full rounded-xl border border-stone-300 px-4 py-3 focus:border-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-200" %>
        </div>
        <p class="text-sm text-stone-500" data-address-autocomplete-target="message" role="status"></p>
      </section>

      <%= form.submit "Continue to secure payment", disabled: @entries.any? { |entry| !entry.available } || ENV["GOOGLE_MAPS_BROWSER_API_KEY"].blank?, class: "w-full rounded-full bg-stone-950 px-6 py-4 font-semibold text-white hover:bg-stone-700 disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto" %>
    <% end %>

    <aside class="sticky top-6 overflow-hidden rounded-3xl border border-stone-200 bg-white">
      <div class="border-b border-stone-100 p-6">
        <h2 class="text-xl font-bold text-stone-950">Your order</h2>
      </div>
      <div class="max-h-[50vh] space-y-5 overflow-y-auto p-6">
        <% @entries.group_by { |entry| entry.menu_item&.restaurant }.each do |restaurant, entries| %>
          <section>
            <h3 class="mb-3 text-sm font-semibold text-stone-500"><%= restaurant&.name || "Unavailable items" %></h3>
            <ul class="space-y-3">
              <% entries.each do |entry| %>
                <li class="flex items-center gap-3 text-sm">
                  <% if entry.menu_item&.photo&.attached? %>
                    <%= image_tag entry.menu_item.photo, class: "size-12 rounded-xl object-cover", alt: entry.menu_item.name %>
                  <% else %>
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-stone-100 font-bold text-stone-300"><%= entry.menu_item&.name&.first&.upcase || "?" %></div>
                  <% end %>
                  <span class="min-w-0 flex-1"><span class="font-semibold text-stone-900"><%= entry.quantity %> × <%= entry.menu_item&.name || "Unavailable item" %></span></span>
                  <% if entry.available %><span class="font-semibold text-stone-900"><%= number_to_currency(entry.menu_item.price * entry.quantity) %></span><% end %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>
      <div class="border-t border-stone-100 bg-stone-50 p-6">
        <p class="flex justify-between text-sm text-stone-600"><span>Items subtotal</span><span><%= number_to_currency(@total) %></span></p>
        <p class="mt-2 flex justify-between text-sm text-stone-500"><span>Delivery</span><span>Calculated by distance</span></p>
        <p class="mt-4 flex justify-between border-t border-stone-200 pt-4 font-bold text-stone-950"><span>Subtotal</span><span><%= number_to_currency(@total) %></span></p>
      </div>
    </aside>
  </div>
<% end %>
