<% content_for :title, "#{Current.organization.name} | Organization dashboard" %>
<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-orange-800">Organization overview</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight text-stone-950"><%= Current.organization.name %></h1>
    <p class="mt-2 text-stone-600">Restaurant performance and current operations.</p>
  </div>
</div>

<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Organization summary">
  <% [
    ["Restaurants", number_with_delimiter(@restaurants.size), "In this Organization"],
    ["Orders today", number_with_delimiter(@today_orders_count), "Non-cancelled orders"],
    ["Active orders", number_with_delimiter(@active_orders_count), "Pending, preparing, or ready"],
    ["Completed sales today", number_to_currency(@today_revenue), "Completed item sales"]
  ].each do |label, value, detail| %>
    <article class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-stone-600"><%= label %></p>
      <p class="mt-2 text-3xl font-bold tracking-tight text-stone-950"><%= value %></p>
      <p class="mt-2 text-xs text-stone-500"><%= detail %></p>
    </article>
  <% end %>
</section>

<section class="mt-10" aria-label="Organization performance">
  <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-stone-950">Performance</h2>
      <p class="mt-1 text-sm text-stone-600">Trends and Restaurant comparisons for this Organization.</p>
    </div>
    <nav class="flex items-center gap-2" aria-label="Chart date range">
      <% { "7" => "7 days", "30" => "30 days", "90" => "90 days" }.each do |range, label| %>
        <%= link_to label, organization_admin_root_path(range: range),
          aria: { current: @chart_range == range ? "date" : nil },
          class: "rounded-lg border px-3 py-2 text-sm font-semibold #{@chart_range == range ? 'border-stone-950 bg-stone-950 text-white' : 'border-stone-300 bg-white text-stone-700 hover:bg-stone-100'}" %>
      <% end %>
    </nav>
  </div>

  <div class="grid gap-5 lg:grid-cols-2">
    <%= render "admin/dashboard/trend_chart",
      title: "Orders per day",
      description: "All orders by creation date.",
      aria_label: "Organization orders per day",
      series: @orders_by_day,
      chart_range: @chart_range,
      history_path: ->(filters) { organization_admin_order_history_path(filters) },
      currency: false %>
    <%= render "admin/dashboard/trend_chart",
      title: "Completed sales per day",
      description: "Completed order totals by creation date, including checkout delivery fees.",
      aria_label: "Organization completed sales per day",
      series: @sales_by_day,
      chart_range: @chart_range,
      history_path: ->(filters) { organization_admin_order_history_path(filters) },
      currency: true %>

    <%= render "admin/dashboard/bar_chart",
      title: "Orders by kitchen status",
      description: "Orders in this Organization created in the selected date range.",
      aria_label: "Organization orders by kitchen status",
      items: @orders_by_status.map { |status, count| { label: status.humanize, value: count, filter_params: { status: status } } },
      chart_range: @chart_range,
      history_path: ->(filters) { organization_admin_order_history_path(filters) },
      empty_message: "No order statuses to show." %>
    <%= render "admin/dashboard/bar_chart",
      title: "Top Restaurants",
      description: "Top 10 by completed order count in the selected date range.",
      aria_label: "Organization Restaurants by completed orders",
      items: @top_restaurants.map { |id, name, count| { label: name, value: count, filter_params: { restaurant_id: id, status: "completed" } } },
      chart_range: @chart_range,
      history_path: ->(filters) { organization_admin_order_history_path(filters) },
      empty_message: "No completed orders in this date range." %>
  </div>
</section>

<section class="mt-10">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 class="text-xl font-bold tracking-tight text-stone-950">Restaurants</h2>
      <p class="mt-1 text-sm text-stone-600">Manage settings or open a Restaurant's operations workspace.</p>
    </div>
    <%= link_to "View all", organization_admin_restaurants_path, class: "text-sm font-semibold text-stone-700 underline decoration-stone-300 underline-offset-4 hover:text-stone-950" %>
  </div>
  <% if @restaurants.empty? %>
    <p class="rounded-xl border border-dashed border-stone-300 bg-white p-8 text-center text-stone-600">No Restaurants in this Organization yet.</p>
  <% else %>
    <ul class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
      <% @restaurants.each do |restaurant| %>
        <li class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="font-semibold text-stone-950"><%= restaurant.name %></h3>
              <p class="mt-1 text-sm text-stone-600"><%= pluralize(@restaurant_order_counts.fetch(restaurant.id, 0), "order") %></p>
            </div>
            <span class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-semibold text-stone-600">Restaurant</span>
          </div>
          <div class="mt-4 flex gap-4 border-t border-stone-100 pt-4 text-sm">
            <%= link_to "Settings", edit_organization_admin_restaurant_path(restaurant), class: "font-semibold text-stone-800 underline decoration-stone-300 underline-offset-4 hover:text-orange-800" %>
            <%= button_to "Manage operations", select_staff_restaurant_path(restaurant), method: :patch, class: "font-semibold text-stone-800 underline decoration-stone-300 underline-offset-4 hover:text-orange-800" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section class="mt-10">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 class="text-xl font-bold tracking-tight text-stone-950">Recent orders</h2>
      <p class="mt-1 text-sm text-stone-600">Latest activity across the Organization.</p>
    </div>
    <%= link_to "View order history", organization_admin_order_history_path, class: "text-sm font-semibold text-stone-700 underline decoration-stone-300 underline-offset-4 hover:text-stone-950" %>
  </div>
  <% if @recent_orders.empty? %>
    <p class="rounded-xl border border-dashed border-stone-300 bg-white p-8 text-center text-stone-600">No orders yet.</p>
  <% else %>
    <div class="overflow-x-auto rounded-xl border border-stone-200 bg-white shadow-sm">
      <table class="w-full min-w-[640px] text-left text-sm">
        <thead class="bg-stone-100 text-xs uppercase tracking-wide text-stone-500">
          <tr><th class="px-4 py-3">Restaurant and customer</th><th class="px-4 py-3">Created</th><th class="px-4 py-3">Kitchen status</th><th class="px-4 py-3 text-right">Order total</th></tr>
        </thead>
        <tbody class="divide-y divide-stone-200">
          <% @recent_orders.each do |order| %>
            <% total = order.order_items.sum { |item| item.unit_price * item.quantity } + (order.checkout_group&.delivery_fee || 0) %>
            <tr>
              <td class="px-4 py-3"><span class="font-semibold text-stone-950"><%= order.restaurant.name %></span><span class="block text-stone-600"><%= order.customer_name %></span></td>
              <td class="whitespace-nowrap px-4 py-3 text-stone-600"><%= l(order.created_at, format: :short) %></td>
              <td class="px-4 py-3"><span class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-semibold text-stone-700"><%= order.status.humanize %></span></td>
              <td class="whitespace-nowrap px-4 py-3 text-right font-semibold text-stone-950"><%= number_to_currency(total) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
