<% content_for :title, "Order history | #{Current.organization.name}" %>
<div class="mb-6">
  <p class="text-sm font-semibold uppercase tracking-wide text-emerald-800">Organization</p>
  <h1 class="mt-1 text-3xl font-bold tracking-tight text-stone-900">Order history</h1>
  <p class="mt-2 text-stone-600">Orders placed at restaurants in <%= Current.organization.name %>.</p>
</div>
<%= render "shared/search_form", url: organization_admin_order_history_path, query: @query, placeholder: "Search order ID, restaurant, driver, or status", preserve_params: request.query_parameters %>

<% if @orders.empty? %>
  <p class="rounded-xl border border-dashed border-stone-300 bg-white p-8 text-center text-stone-600">No orders match this history view.</p>
<% else %>
  <div class="overflow-x-auto rounded-xl border border-stone-200 bg-white shadow-sm">
    <table class="w-full min-w-[700px] text-left text-sm">
      <thead class="bg-stone-100 text-xs uppercase tracking-wide text-stone-600">
        <tr>
          <th class="px-4 py-3">Order</th>
          <th class="px-4 py-3">Created</th>
          <th class="px-4 py-3">Restaurant</th>
          <th class="px-4 py-3">Kitchen status</th>
          <th class="px-4 py-3">Delivery status</th>
          <th class="px-4 py-3">Driver</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-200">
        <% @orders.each do |order| %>
          <tr id="order-<%= order.id %>">
            <td class="whitespace-nowrap px-4 py-3 font-semibold text-stone-900">Order #<%= order.id %></td>
            <td class="whitespace-nowrap px-4 py-3 text-stone-600"><%= l(order.created_at, format: :short) %></td>
            <td class="px-4 py-3"><%= order.restaurant.name %></td>
            <td class="px-4 py-3"><%= order.status.humanize %></td>
            <td class="px-4 py-3"><%= order.checkout_group ? order.delivery_status.humanize : "—" %></td>
            <td class="px-4 py-3"><%= order.driver&.name || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @orders.size == 100 %><p class="mt-4 text-sm text-stone-600">Showing the 100 most recent matching orders.</p><% end %>
<% end %>
