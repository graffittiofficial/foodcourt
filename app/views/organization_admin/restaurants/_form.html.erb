<%= form_with model: [:organization_admin, restaurant], class: "max-w-3xl space-y-6" do |form| %>
  <% if restaurant.errors.any? %><div class="rounded-lg bg-red-50 p-4 text-red-800" role="alert"><ul class="list-inside list-disc"><% restaurant.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <section class="space-y-4 rounded-xl border border-stone-200 bg-white p-6">
    <h2 class="text-xl font-bold">Restaurant details</h2>
    <div><%= form.label :name, class: "mb-1 block font-semibold" %><%= form.text_field :name, required: true, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
    <div><%= form.label :description, class: "mb-1 block font-semibold" %><%= form.text_area :description, rows: 3, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
    <% if restaurant.photo.attached? %><%= image_tag restaurant.photo, class: "aspect-[16/7] w-full rounded-xl object-cover", alt: restaurant.name %><% end %>
    <div><%= form.label :photo, "Restaurant cover photo (JPEG, PNG, or WebP; max 5 MB)", class: "mb-1 block font-semibold" %><%= form.file_field :photo, accept: "image/jpeg,image/png,image/webp", class: "block w-full text-sm text-stone-600" %></div>
  </section>
  <section class="space-y-4 rounded-xl border border-stone-200 bg-white p-6">
    <h2 class="text-xl font-bold">Delivery location and pricing</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= form.label :address_line1, class: "mb-1 block font-semibold" %><%= form.text_field :address_line1, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
      <div><%= form.label :city, class: "mb-1 block font-semibold" %><%= form.text_field :city, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
      <div><%= form.label :region, class: "mb-1 block font-semibold" %><%= form.text_field :region, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
      <div><%= form.label :postal_code, class: "mb-1 block font-semibold" %><%= form.text_field :postal_code, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
      <div><%= form.label :country_code, class: "mb-1 block font-semibold" %><%= form.text_field :country_code, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
      <div><%= form.label :google_place_id, class: "mb-1 block font-semibold" %><%= form.text_field :google_place_id, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
      <div><%= form.label :delivery_base_fee, class: "mb-1 block font-semibold" %><%= form.number_field :delivery_base_fee, min: 0, step: "0.01", class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
      <div><%= form.label :delivery_fee_per_km, class: "mb-1 block font-semibold" %><%= form.number_field :delivery_fee_per_km, min: 0, step: "0.01", class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
      <div><%= form.label :max_delivery_distance_km, class: "mb-1 block font-semibold" %><%= form.number_field :max_delivery_distance_km, min: "0.01", step: "0.01", class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
    </div>
  </section>
  <%= form.submit class: "rounded-full bg-stone-950 px-5 py-3 font-semibold text-white hover:bg-stone-700" %>
<% end %>
