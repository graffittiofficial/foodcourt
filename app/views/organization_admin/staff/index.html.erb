<% content_for :title, "Restaurant staff | #{Current.organization.name}" %>
<h1 class="mb-6 text-3xl font-bold">Restaurant staff</h1>
<section class="mb-8 max-w-2xl rounded-xl border border-stone-200 bg-white p-6">
  <h2 class="mb-4 text-xl font-bold">Invite staff</h2>
  <% if @invitation&.errors&.any? %><div class="mb-4 rounded-lg bg-red-50 p-4 text-red-800" role="alert"><%= @invitation.errors.full_messages.to_sentence %></div><% end %>
  <%= form_with url: organization_admin_staff_index_path, scope: :staff, class: "space-y-4" do |form| %>
    <div><%= form.label :email_address, "Email address", class: "mb-1 block font-semibold" %><%= form.email_field :email_address, required: true, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
    <fieldset>
      <legend class="mb-2 font-semibold">Assign Restaurants</legend>
      <div class="space-y-2">
        <% @restaurants.each do |restaurant| %>
          <label class="flex items-center gap-2"><%= check_box_tag "staff[restaurant_ids][]", restaurant.id, Array(params.dig(:staff, :restaurant_ids)).include?(restaurant.id.to_s) %><span><%= restaurant.name %></span></label>
        <% end %>
      </div>
      <% if @restaurants.empty? %><p class="text-sm text-stone-600">Create a Restaurant before inviting staff.</p><% end %>
    </fieldset>
    <%= form.submit "Send invitation", disabled: @restaurants.empty?, class: "rounded-lg bg-stone-950 px-4 py-2 font-semibold text-white disabled:opacity-50" %>
  <% end %>
</section>
<section>
  <h2 class="mb-4 text-xl font-bold">Current assignments</h2>
  <% if @memberships.empty? %><p class="text-stone-600">No Restaurant staff assigned.</p><% else %>
    <ul class="divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white">
      <% @memberships.each do |membership| %>
        <li class="flex items-center justify-between gap-4 p-4">
          <span><%= membership.user.email_address %> · <%= membership.restaurant.name %></span>
          <%= button_to "Remove access", organization_admin_staff_path(membership), method: :delete, class: "font-semibold text-red-700 underline" %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
<section class="mt-8">
  <h2 class="mb-4 text-xl font-bold">Pending invitations</h2>
  <% if @invitations.empty? %><p class="text-stone-600">No pending staff invitations.</p><% else %>
    <ul class="space-y-2">
      <% @invitations.each do |invitation| %>
        <li class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-stone-200 bg-white p-4">
          <span><%= invitation.email_address %> · <%= invitation.restaurants.map(&:name).to_sentence %> · <%= invitation.active? ? "expires #{l(invitation.expires_at, format: :short)}" : "expired" %></span>
          <div class="flex gap-3">
            <%= button_to "Resend", resend_organization_admin_invitation_path(invitation), method: :patch, class: "underline" %>
            <%= button_to "Revoke", organization_admin_invitation_path(invitation), method: :delete, class: "text-red-700 underline" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
