<% content_for :title, "Organization profile | Foodcourt" %>
<h1 class="mb-6 text-3xl font-bold">Organization profile</h1>
<%= form_with model: @organization, url: organization_admin_profile_path, class: "max-w-xl space-y-4 rounded-xl border border-stone-200 bg-white p-6" do |form| %>
  <% if @organization.errors.any? %><div class="rounded-lg bg-red-50 p-4 text-red-800" role="alert"><%= @organization.errors.full_messages.to_sentence %></div><% end %>
  <div><%= form.label :name, class: "mb-1 block font-semibold" %><%= form.text_field :name, required: true, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
  <div><%= form.label :time_zone, "Time zone", class: "mb-1 block font-semibold" %><%= form.select :time_zone, [ [ "UTC", "UTC" ] ] + ActiveSupport::TimeZone.all.map { |zone| [ zone.name, zone.tzinfo.name ] }.reject { |_label, value| value == "UTC" }, { selected: @organization.time_zone }, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
  <%= form.submit "Save profile", class: "rounded-lg bg-stone-950 px-4 py-2 font-semibold text-white" %>
<% end %>
