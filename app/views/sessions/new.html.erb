<% content_for :title, "Sign in - Foodcourt" %>

<section class="mx-auto grid max-w-5xl overflow-hidden rounded-[2rem] bg-white shadow-xl shadow-stone-900/10 ring-1 ring-stone-900/5 lg:grid-cols-[1.05fr_0.95fr]">
  <div class="relative flex min-h-[360px] flex-col justify-between overflow-hidden bg-orange-600 p-8 text-white sm:p-10 lg:min-h-[620px] lg:p-12">
    <div class="absolute -right-12 -top-12 h-64 w-64 rounded-full border-[18px] border-white/15 bg-amber-300 sm:h-80 sm:w-80" aria-hidden="true">
      <div class="absolute inset-7 rounded-full border-[14px] border-orange-500/40 sm:inset-9"></div>
      <div class="absolute inset-16 rounded-full bg-orange-700/20 sm:inset-20"></div>
      <span class="absolute left-1/2 top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/80"></span>
    </div>

    <%= link_to root_path, class: "relative inline-flex w-fit items-center gap-2 rounded-full border border-white/25 bg-white/10 px-4 py-2 text-sm font-semibold tracking-wide text-white backdrop-blur-sm" do %>
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-300 text-xs font-black text-orange-800" aria-hidden="true">F</span>
      FOODCOURT
    <% end %>

    <div class="relative mt-16 max-w-md">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-orange-100">Your table is waiting</p>
      <h1 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">Good food.<br>Great company.</h1>
      <p class="mt-5 max-w-sm text-base leading-7 text-orange-50/90">Sign in to pick up where you left off and get back to the flavors you love.</p>
    </div>
  </div>

  <div class="flex flex-col justify-center p-8 sm:p-12 lg:px-14">
    <div class="mx-auto w-full max-w-sm">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-orange-700">Welcome back</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-stone-900">Sign in to your account</h2>
      <p class="mt-3 text-sm leading-6 text-stone-600">Enter your details below to continue.</p>

      <%= form_with url: session_path, class: "mt-8 space-y-5" do |form| %>
        <div>
          <%= form.label :email_address, "Email address", class: "mb-2 block text-sm font-medium text-stone-700" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address], class: "block w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-900 shadow-sm outline-none transition placeholder:text-stone-400 focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" %>
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between gap-4">
            <%= form.label :password, class: "block text-sm font-medium text-stone-700" %>
            <%= link_to "Forgot password?", new_password_path, class: "text-sm font-semibold text-orange-700 transition hover:text-orange-800 hover:underline" %>
          </div>
          <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72, class: "block w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-900 shadow-sm outline-none transition placeholder:text-stone-400 focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" %>
        </div>

        <%= form.submit "Sign in", class: "inline-flex w-full cursor-pointer items-center justify-center rounded-xl bg-orange-600 px-5 py-3.5 text-sm font-semibold text-white shadow-lg shadow-orange-600/20 transition hover:bg-orange-700 focus:outline-none focus:ring-4 focus:ring-orange-500/30" %>
      <% end %>

      <p class="mt-8 text-center text-xs leading-5 text-stone-500">Your next favorite meal is just around the corner.</p>
      <p class="mt-4 text-center text-sm text-stone-600">New to Foodcourt? <%= link_to "Create a customer account", new_registration_path, class: "font-semibold text-orange-700 hover:underline" %></p>
    </div>
  </div>
</section>
