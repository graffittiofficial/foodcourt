<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Foodcourt" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Foodcourt">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": Rails.env.production? ? "reload" : "" %>
    <%= javascript_include_tag "application", "data-turbo-track": Rails.env.production? ? "reload" : "", type: "module" %>
  </head>

  <body class="min-h-screen bg-stone-50 text-stone-950 antialiased">
    <header class="sticky top-0 z-40 border-b border-stone-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
        <%= link_to root_path, class: "flex items-center gap-2 text-xl font-extrabold tracking-tight text-stone-950" do %>
          <span class="flex size-8 items-center justify-center rounded-xl bg-stone-950 text-sm text-white" aria-hidden="true">F</span>
          Foodcourt
        <% end %>
        <nav class="flex flex-wrap items-center gap-3 text-sm font-medium text-stone-700 sm:gap-5" aria-label="Account navigation">
          <%= link_to "Search", search_path %>
          <% if Current.account.is_a?(User) && (Current.user.staff? || Current.user.organization_admin?) %>
            <%= link_to "Reports", reports_path %>
          <% end %>
          <% if Current.account&.admin? %>
            <%= link_to "Administration", admin_root_path %>
          <% end %>
          <% if Current.account.is_a?(User) && Current.user.organization_admin? %>
            <%= link_to "Organization", organization_admin_root_path %>
            <%= link_to "Restaurants", organization_admin_restaurants_path %>
            <%= link_to "Order history", organization_admin_order_history_path %>
            <%= link_to "Reviews", organization_admin_reviews_path %>
            <%= link_to "Staff", organization_admin_staff_index_path %>
            <%= link_to "Organization admins", organization_admin_admins_path %>
            <%= link_to "Organization profile", edit_organization_admin_profile_path %>
            <%= form_with url: switch_organizations_path, method: :patch, class: "flex items-center gap-2" do |form| %>
              <%= form.collection_select :organization_id, Current.user.administered_organizations.order(:name), :id, :name, { selected: Current.organization&.id }, class: "rounded border border-stone-300 px-2 py-1" %>
              <%= form.submit "Switch", class: "cursor-pointer underline" %>
            <% end %>
          <% end %>
          <% if Current.account&.staff? %>
            <%= link_to "Staff dashboard", staff_dashboard_path if Current.restaurant %>
            <%= link_to "Orders", staff_orders_path if Current.restaurant %>
            <%= link_to "Menu", staff_menu_items_path if Current.restaurant %>
            <% if Current.restaurant %>
              <%= form_with url: select_staff_restaurant_path(Current.restaurant), method: :patch, class: "flex items-center gap-2" do |form| %>
                <%= form.collection_select :id, Current.user.restaurants.order(:name), :id, :name, { selected: Current.restaurant.id }, class: "rounded border border-stone-300 px-2 py-1" %>
                <%= form.submit "Switch", class: "cursor-pointer underline" %>
              <% end %>
            <% else %>
              <%= link_to "Choose restaurant", staff_restaurants_path %>
            <% end %>
          <% end %>
          <% if Current.account.is_a?(User) && Current.account.driver? %>
            <%= link_to "My deliveries", driver_root_path %>
          <% end %>
          <% if Current.account.is_a?(User) && Current.user.customer? %>
            <%= link_to "Restaurants", restaurants_path, class: "hidden hover:text-stone-950 sm:inline" %>
            <%= link_to "Basket", cart_path, class: "rounded-full border border-stone-300 px-3 py-2 hover:border-stone-950 hover:text-stone-950" %>
            <%= link_to "My orders", orders_path, class: "hidden hover:text-stone-950 sm:inline" %>
          <% elsif Current.account.nil? %>
            <%= link_to "Restaurants", restaurants_path, class: "hidden hover:text-stone-950 sm:inline" %>
            <%= link_to "Basket", cart_path, class: "rounded-full border border-stone-300 px-3 py-2 hover:border-stone-950 hover:text-stone-950" %>
            <%= link_to "Sign in", new_session_path, class: "hidden hover:text-stone-950 sm:inline" %>
            <%= link_to "Create account", new_registration_path, class: "rounded-full bg-stone-950 px-4 py-2.5 font-semibold text-white hover:bg-stone-700" %>
          <% end %>
          <% if Current.account.present? %>
            <%= button_to "Sign out", session_path, method: :delete, class: "text-stone-700" %>
          <% end %>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-7xl px-4 py-6 pb-24 sm:px-6 sm:py-10">
      <% flash.each do |type, message| %>
        <p class="mb-5 rounded-lg px-4 py-3 <%= type == "alert" ? "bg-red-50 text-red-800" : "bg-green-50 text-green-800" %>" role="<%= type == "alert" ? "alert" : "status" %>"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
    <% if Current.account.nil? || Current.account.is_a?(User) && Current.account.customer? %>
      <nav class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-stone-200 bg-white/95 px-3 py-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] text-center text-xs font-semibold text-stone-600 backdrop-blur sm:hidden" aria-label="Customer quick navigation">
        <%= link_to restaurants_path, class: "flex flex-col items-center gap-1 py-1 hover:text-stone-950" do %><span aria-hidden="true">⌂</span>Browse<% end %>
        <%= link_to cart_path, class: "flex flex-col items-center gap-1 py-1 hover:text-stone-950" do %><span aria-hidden="true">▢</span>Basket<% end %>
        <% if Current.account.is_a?(User) && Current.account.customer? %>
          <%= link_to orders_path, class: "flex flex-col items-center gap-1 py-1 hover:text-stone-950" do %><span aria-hidden="true">◷</span>Orders<% end %>
        <% else %>
          <%= link_to new_session_path, class: "flex flex-col items-center gap-1 py-1 hover:text-stone-950" do %><span aria-hidden="true">◷</span>Sign in<% end %>
        <% end %>
      </nav>
    <% end %>
  </body>
</html>
