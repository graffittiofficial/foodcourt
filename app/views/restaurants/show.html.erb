<% content_for :title, "#{@restaurant.name} | Foodcourt" %>
<div class="mb-8 overflow-hidden rounded-3xl border border-stone-200 bg-white">
  <% if @restaurant.photo.attached? %>
    <%= image_tag @restaurant.photo, class: "h-56 w-full object-cover sm:h-80", alt: @restaurant.name %>
  <% else %>
    <div class="flex h-48 items-center justify-center bg-stone-100 text-6xl font-bold text-stone-300 sm:h-64"><%= @restaurant.name.first(1).upcase %></div>
  <% end %>
  <div class="flex flex-wrap items-end justify-between gap-4 p-6 sm:p-8">
    <div>
      <%= link_to "← All restaurants", restaurants_path, class: "text-sm font-semibold text-stone-500 hover:text-stone-950" %>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-bold tracking-tight text-stone-950 sm:text-4xl"><%= @restaurant.name %></h1>
        <%= render "shared/rating_summary", record: @restaurant %>
      </div>
      <% if @restaurant.description.present? %><p class="mt-2 max-w-2xl text-stone-600"><%= @restaurant.description %></p><% end %>
      <p class="mt-3 text-sm text-stone-500"><%= @menu_items.length %> available items</p>
    </div>
    <%= link_to "View basket", cart_path, class: "rounded-full bg-stone-950 px-5 py-3 font-semibold text-white hover:bg-stone-700" %>
  </div>
</div>

<% if @menu_items.empty? %>
  <p class="rounded-2xl border border-dashed border-stone-300 bg-white p-8 text-center text-stone-600">This restaurant has no available menu items right now.</p>
<% else %>
  <div class="grid gap-4 md:grid-cols-2">
    <% @menu_items.each do |menu_item| %>
      <article class="flex min-h-36 items-center justify-between gap-4 overflow-hidden rounded-2xl border border-stone-200 bg-white p-4">
        <div class="min-w-0 flex-1">
          <h2 class="font-bold text-stone-950"><%= menu_item.name %></h2>
          <%= render "shared/rating_summary", record: menu_item %>
          <% if menu_item.description.present? %><p class="mt-2 line-clamp-2 text-sm text-stone-600"><%= menu_item.description %></p><% end %>
          <p class="mt-3 font-semibold text-stone-950"><%= number_to_currency(menu_item.price) %></p>
          <% menu_reviews = menu_item.reviews.select { |review| review.body.present? }.sort_by(&:created_at).reverse.first(2) %>
          <% if menu_reviews.any? %>
            <details class="mt-3 text-sm">
              <summary class="cursor-pointer font-semibold text-stone-600 hover:text-stone-950">Customer comments</summary>
              <ul class="mt-2 space-y-2">
                <% menu_reviews.each do |review| %>
                  <li class="rounded-xl bg-stone-50 p-3">
                    <p class="font-semibold text-stone-800"><span class="text-amber-500" aria-label="<%= review.rating %> stars"><%= "★" * review.rating %></span> · Verified order</p>
                    <p class="mt-1 text-stone-600"><%= review.body %></p>
                  </li>
                <% end %>
              </ul>
            </details>
          <% end %>
        </div>
        <div class="flex shrink-0 flex-col items-center gap-2">
          <% if menu_item.photo.attached? %>
            <%= image_tag menu_item.photo, class: "size-24 rounded-2xl object-cover sm:size-28", alt: menu_item.name, loading: "lazy" %>
          <% else %>
            <div class="flex size-24 items-center justify-center rounded-2xl bg-stone-100 text-2xl font-bold text-stone-300 sm:size-28"><%= menu_item.name.first(1).upcase %></div>
          <% end %>
          <%= form_with url: cart_items_path do |form| %>
            <%= hidden_field_tag :menu_item_id, menu_item.id %>
            <%= hidden_field_tag :quantity, 1 %>
            <%= form.submit "＋ Add", class: "rounded-full border border-stone-300 bg-white px-4 py-2 text-sm font-bold text-stone-950 shadow-sm hover:bg-stone-100" %>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
<% end %>

<% restaurant_reviews = @restaurant.reviews.select { |review| review.body.present? }.sort_by(&:created_at).reverse.first(6) %>
<% if restaurant_reviews.any? %>
  <section class="mt-10">
    <div class="mb-4">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-stone-500">From customers</p>
      <h2 class="mt-1 text-2xl font-bold tracking-tight text-stone-950">Reviews for <%= @restaurant.name %></h2>
    </div>
    <ul class="grid gap-4 md:grid-cols-2">
      <% restaurant_reviews.each do |review| %>
        <li class="rounded-2xl border border-stone-200 bg-white p-5">
          <p class="font-semibold text-stone-900"><span class="text-amber-500" aria-label="<%= review.rating %> stars"><%= "★" * review.rating %></span> · Verified order</p>
          <p class="mt-2 text-stone-700"><%= review.body %></p>
          <p class="mt-3 text-xs text-stone-500"><%= l(review.created_at, format: :short) %></p>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
