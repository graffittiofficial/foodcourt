<% if restaurants.empty? %>
  <p class="rounded-xl border border-dashed border-stone-300 p-8 text-center text-stone-600">No restaurants are available yet.</p>
<% else %>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <% restaurants.each do |restaurant| %>
      <article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold text-stone-900"><%= link_to restaurant.name, restaurant_path(restaurant), class: "hover:text-orange-700" %></h2>
        <% if restaurant.description.present? %><p class="mt-2 text-stone-600"><%= restaurant.description %></p><% end %>
        <p class="mt-4 text-sm text-stone-500"><%= restaurant.menu_items.available.count %> available menu items</p>
        <%= link_to "Browse menu", restaurant_path(restaurant), class: "mt-5 inline-flex font-semibold text-orange-700 hover:underline" %>
      </article>
    <% end %>
  </div>
<% end %>
