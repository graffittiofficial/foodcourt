<% if restaurants.empty? %>
  <p class="rounded-2xl border border-dashed border-stone-300 bg-white p-10 text-center text-stone-600"><%= params[:q].present? ? "No restaurants match your search." : "No restaurants are available yet." %></p>
<% else %>
  <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
    <% restaurants.each do |restaurant| %>
      <article class="group overflow-hidden rounded-3xl border border-stone-200 bg-white transition hover:-translate-y-0.5 hover:shadow-lg">
        <%= link_to restaurant_path(restaurant), class: "block" do %>
          <% if restaurant.photo.attached? %>
            <%= image_tag restaurant.photo, class: "aspect-[16/10] w-full object-cover transition duration-300 group-hover:scale-[1.02]", alt: restaurant.name, loading: "lazy" %>
          <% else %>
            <div class="flex aspect-[16/10] items-center justify-center bg-stone-100 text-5xl font-bold tracking-tight text-stone-300"><%= restaurant.name.first(1).upcase %></div>
          <% end %>
          <div class="p-5">
            <div class="flex items-start justify-between gap-3">
              <h2 class="text-xl font-bold tracking-tight text-stone-950"><%= restaurant.name %></h2>
              <%= render "shared/rating_summary", record: restaurant %>
            </div>
            <% if restaurant.description.present? %><p class="mt-2 line-clamp-2 text-sm text-stone-600"><%= restaurant.description %></p><% end %>
            <div class="mt-4 flex items-center justify-between border-t border-stone-100 pt-4 text-sm text-stone-500">
              <span><%= restaurant.menu_items.count { |item| item.available? && item.archived_at.nil? } %> available items</span>
              <span class="font-semibold text-stone-900">View menu <span aria-hidden="true">→</span></span>
            </div>
          </div>
        <% end %>
      </article>
    <% end %>
  </div>
<% end %>
