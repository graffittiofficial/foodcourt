<% content_for :title, "Admin dashboard | Foodcourt" %>

<div class="mb-8">
  <p class="text-sm font-semibold uppercase tracking-wide text-orange-700">Administration</p>
  <h1 class="mt-1 text-3xl font-bold tracking-tight">Dashboard</h1>
  <p class="mt-2 text-stone-600">A snapshot of activity across Foodcourt.</p>
</div>

<section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Platform summary">
  <% [
    ["Users", @user_count],
    ["Restaurants", @restaurant_count],
    ["Menu items", @menu_item_count],
    ["Orders", @order_count]
  ].each do |label, count| %>
    <article class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-stone-600"><%= label %></p>
      <p class="mt-2 text-3xl font-bold"><%= count %></p>
    </article>
  <% end %>
</section>
<% content_for :title, "Admin dashboard | Foodcourt" %>
<h1 class="mb-6 text-3xl font-bold text-stone-900">Administration</h1>
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <% [["Customers and staff", @user_count], ["Restaurants", @restaurant_count], ["Menu items", @menu_item_count], ["Orders", @order_count]].each do |label, count| %>
    <article class="rounded-xl border border-stone-200 bg-white p-5"><p class="text-sm text-stone-600"><%= label %></p><p class="mt-2 text-3xl font-bold"><%= count %></p></article>
  <% end %>
</div>
<nav class="mt-8 flex flex-wrap gap-3">
  <%= link_to "Configure restaurants", admin_restaurants_path, class: "rounded-lg bg-orange-600 px-4 py-2.5 font-semibold text-white" %>
  <%= link_to "Assign deliveries", admin_orders_path, class: "rounded-lg border border-stone-300 px-4 py-2.5 font-semibold" %>
  <%= link_to "Manage drivers", admin_drivers_path, class: "rounded-lg border border-stone-300 px-4 py-2.5 font-semibold" %>
</nav>