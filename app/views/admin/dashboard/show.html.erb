<% content_for :title, "Admin dashboard | Foodcourt" %>

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-orange-700">Administration</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight text-stone-900">Dashboard</h1>
    <p class="mt-2 text-stone-600">Sales performance and day-to-day platform operations.</p>
  </div>
  <%= link_to "Add restaurant", new_admin_restaurant_path, class: "rounded-lg bg-orange-600 px-4 py-2.5 font-semibold text-white hover:bg-orange-700" %>
</div>

<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Sales overview">
  <% [
    ["All-time sales", number_with_delimiter(@all_time_sales_count), "Completed orders"],
    ["All-time revenue", number_to_currency(@all_time_revenue), "Completed orders, including delivery"],
    ["Today's orders", number_with_delimiter(@today_order_count), "Non-cancelled orders"],
    ["Today's revenue", number_to_currency(@today_revenue), "Completed orders, including delivery"]
  ].each do |label, value, detail| %>
    <article class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-stone-600"><%= label %></p>
      <p class="mt-2 text-3xl font-bold tracking-tight text-stone-900"><%= value %></p>
      <p class="mt-2 text-xs text-stone-500"><%= detail %></p>
    </article>
  <% end %>
</section>

<section class="mt-10 grid gap-6 lg:grid-cols-2" aria-label="Operations overview">
  <article class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
    <div class="mb-4">
      <h2 class="text-xl font-bold text-stone-900">Pending orders</h2>
      <p class="mt-1 text-sm text-stone-600">Orders waiting for restaurant teams to start preparing.</p>
    </div>
    <% if @pending_orders.empty? %>
      <p class="rounded-lg border border-dashed border-stone-300 p-5 text-center text-sm text-stone-600">No orders are waiting to be started.</p>
    <% else %>
      <ul class="divide-y divide-stone-200">
        <% @pending_orders.each do |order| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-3">
            <div>
              <p class="font-semibold text-stone-900"><%= order.restaurant.name %> · Order #<%= order.id %></p>
              <p class="mt-1 text-sm text-stone-600"><%= order.customer_name %> · <%= l(order.created_at, format: :short) %></p>
            </div>
            <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800">Pending</span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </article>

  <article class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-center justify-between gap-3">
      <div>
        <h2 class="text-xl font-bold text-stone-900">Unassigned deliveries</h2>
        <p class="mt-1 text-sm text-stone-600">Orders waiting for a driver.</p>
      </div>
      <%= link_to "Manage deliveries", admin_orders_path, class: "shrink-0 text-sm font-semibold text-orange-700 hover:underline" %>
    </div>
    <% if @unassigned_orders.empty? %>
      <p class="rounded-lg border border-dashed border-stone-300 p-5 text-center text-sm text-stone-600">No deliveries are waiting for assignment.</p>
    <% else %>
      <ul class="divide-y divide-stone-200">
        <% @unassigned_orders.each do |order| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-3">
            <div>
              <p class="font-semibold text-stone-900"><%= order.restaurant.name %> · Order #<%= order.id %></p>
              <p class="mt-1 text-sm text-stone-600"><%= order.customer_name %> · <%= l(order.created_at, format: :short) %></p>
            </div>
            <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800">Unassigned</span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </article>

  <article class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-center justify-between gap-3">
      <div>
        <h2 class="text-xl font-bold text-stone-900">Restaurant setup</h2>
        <p class="mt-1 text-sm text-stone-600"><%= pluralize(@restaurants_needing_setup_count, "restaurant") %> need setup to accept online orders.</p>
      </div>
      <%= link_to "View restaurants", admin_restaurants_path, class: "shrink-0 text-sm font-semibold text-orange-700 hover:underline" %>
    </div>
    <% if @restaurants_needing_setup.empty? %>
      <p class="rounded-lg border border-dashed border-stone-300 p-5 text-center text-sm text-stone-600">All restaurants are ready to accept online orders.</p>
    <% else %>
      <ul class="divide-y divide-stone-200">
        <% @restaurants_needing_setup.each do |restaurant| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-3">
            <div>
              <p class="font-semibold text-stone-900"><%= restaurant.name %></p>
              <p class="mt-1 text-sm text-stone-600">
                <%= restaurant.delivery_configured? ? "Delivery ready" : "Delivery settings incomplete" %>
                · <%= restaurant.stripe_connected? ? "Payments ready" : "Stripe setup incomplete" %>
              </p>
            </div>
            <%= link_to "Complete setup", edit_admin_restaurant_path(restaurant), class: "text-sm font-semibold text-orange-700 hover:underline" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </article>
</section>

<section id="recent-orders" class="mt-10">
  <div class="mb-4 flex items-center justify-between gap-3">
    <div>
      <h2 class="text-xl font-bold text-stone-900">Recent orders</h2>
      <p class="mt-1 text-sm text-stone-600">Latest activity across all restaurants.</p>
    </div>
    <%= link_to "View deliveries", admin_orders_path, class: "text-sm font-semibold text-orange-700 hover:underline" %>
  </div>
  <% if @recent_orders.empty? %>
    <p class="rounded-xl border border-dashed border-stone-300 p-8 text-center text-stone-600">No orders yet.</p>
  <% else %>
    <div class="overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm">
      <ul class="divide-y divide-stone-200">
        <% @recent_orders.each do |order| %>
          <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-4">
            <div>
              <p class="font-semibold text-stone-900"><%= order.restaurant.name %> · Order #<%= order.id %></p>
              <p class="mt-1 text-sm text-stone-600"><%= order.customer_name.presence || order.user&.email_address || "Customer" %> · <%= l(order.created_at, format: :short) %></p>
            </div>
            <div class="text-right">
              <p class="font-semibold text-stone-900"><%= number_to_currency(order.total) %></p>
              <p class="text-sm capitalize text-stone-600"><%= order.status %> · <%= order.delivery_status.humanize %></p>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</section>

<section class="mt-10 border-t border-stone-200 pt-6" aria-label="Platform totals">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-stone-500">Platform totals</h2>
  <dl class="mt-4 grid gap-4 sm:grid-cols-3">
    <div class="rounded-lg bg-stone-100 px-4 py-3">
      <dt class="text-sm text-stone-600">Users</dt>
      <dd class="mt-1 text-xl font-bold text-stone-900"><%= number_with_delimiter(@user_count) %></dd>
    </div>
    <div class="rounded-lg bg-stone-100 px-4 py-3">
      <dt class="text-sm text-stone-600">Restaurants</dt>
      <dd class="mt-1 text-xl font-bold text-stone-900"><%= number_with_delimiter(@restaurant_count) %></dd>
    </div>
    <div class="rounded-lg bg-stone-100 px-4 py-3">
      <dt class="text-sm text-stone-600">Menu items</dt>
      <dd class="mt-1 text-xl font-bold text-stone-900"><%= number_with_delimiter(@menu_item_count) %></dd>
    </div>
  </dl>
</section>

<nav class="mt-8 flex flex-wrap gap-3" aria-label="Quick actions">
  <%= link_to "Configure restaurants", admin_restaurants_path, class: "rounded-lg border border-stone-300 bg-white px-4 py-2.5 font-semibold text-stone-800 hover:bg-stone-100" %>
  <%= link_to "Assign deliveries", admin_orders_path, class: "rounded-lg border border-stone-300 bg-white px-4 py-2.5 font-semibold text-stone-800 hover:bg-stone-100" %>
  <%= link_to "Manage drivers", admin_drivers_path, class: "rounded-lg border border-stone-300 bg-white px-4 py-2.5 font-semibold text-stone-800 hover:bg-stone-100" %>
  <%= link_to "Moderate reviews", admin_reviews_path, class: "rounded-lg border border-stone-300 bg-white px-4 py-2.5 font-semibold text-stone-800 hover:bg-stone-100" %>
</nav>
