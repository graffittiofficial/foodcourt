<% maximum = [items.map { |item| item.fetch(:value) }.max || 0, 1].max %>
<% row_height = 42 %>
<% chart_height = [items.size * row_height + 12, 72].max %>
<% label_width = 170 %>
<% bar_width = 380 %>
<article class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
  <div class="mb-3">
    <h3 class="text-lg font-bold text-stone-900"><%= title %></h3>
    <p class="mt-1 text-sm text-stone-600"><%= description %></p>
  </div>
  <% if items.empty? %>
    <p class="rounded-lg border border-dashed border-stone-300 p-5 text-center text-sm text-stone-600"><%= empty_message %></p>
  <% else %>
    <div class="overflow-x-auto">
      <svg viewBox="0 0 640 <%= chart_height %>" class="w-full min-w-[420px]" role="group" aria-label="<%= aria_label %>">
        <% items.each_with_index do |item, index| %>
          <% y = index * row_height + 8 %>
          <% width = (item.fetch(:value).to_f / maximum * bar_width).round(2) %>
          <%= link_to history_path.call({ range: chart_range, **item.fetch(:filter_params) }),
            aria: { label: "#{item.fetch(:label)}: #{pluralize(item.fetch(:value), 'order')}" } do %>
            <title><%= "#{item.fetch(:label)}: #{pluralize(item.fetch(:value), 'order')}" %></title>
            <text x="4" y="<%= y + 22 %>" fill="#292524" font-size="13"><%= truncate(item.fetch(:label), length: 24) %></text>
            <rect x="<%= label_width %>" y="<%= y + 6 %>" width="<%= bar_width %>" height="20" rx="5" fill="#f5f5f4" />
            <rect x="<%= label_width %>" y="<%= y + 6 %>" width="<%= width %>" height="20" rx="5" fill="#c2410c" />
            <text x="<%= label_width + bar_width + 12 %>" y="<%= y + 22 %>" fill="#292524" font-size="13"><%= number_with_delimiter(item.fetch(:value)) %></text>
          <% end %>
        <% end %>
      </svg>
    </div>
  <% end %>
</article>
