<% content_for :title, "Menu photo | Admin" %>
<div class="mb-6">
  <%= link_to "← #{@restaurant.name}", edit_admin_restaurant_path(@restaurant), class: "text-sm font-semibold text-stone-600 hover:text-stone-900" %>
  <h1 class="mt-2 text-3xl font-bold text-stone-900">Menu item photo</h1>
  <p class="mt-1 text-stone-600"><%= @menu_item.name %></p>
</div>

<%= form_with model: @menu_item, url: admin_restaurant_menu_item_path(@restaurant, @menu_item), class: "max-w-xl space-y-5 rounded-2xl border border-stone-200 bg-white p-6" do |form| %>
  <% if @menu_item.errors.any? %>
    <div class="rounded-xl bg-red-50 p-4 text-red-800" role="alert"><%= @menu_item.errors.full_messages.to_sentence %></div>
  <% end %>
  <% if @menu_item.photo.attached? %>
    <%= image_tag @menu_item.photo, class: "aspect-[4/3] w-full rounded-xl object-cover", alt: @menu_item.name %>
  <% else %>
    <div class="flex aspect-[4/3] items-center justify-center rounded-xl bg-stone-100 text-stone-400">No photo uploaded</div>
  <% end %>
  <div>
    <%= form.label :photo, "Upload a JPEG, PNG, or WebP photo (max 5 MB)", class: "mb-2 block font-semibold" %>
    <%= form.file_field :photo, accept: "image/jpeg,image/png,image/webp", class: "block w-full text-sm text-stone-600 file:mr-4 file:rounded-full file:border-0 file:bg-stone-900 file:px-4 file:py-2 file:font-semibold file:text-white" %>
  </div>
  <div class="flex gap-3">
    <%= form.submit "Save photo", class: "rounded-full bg-stone-900 px-5 py-3 font-semibold text-white hover:bg-stone-700" %>
    <%= link_to "Cancel", edit_admin_restaurant_path(@restaurant), class: "rounded-full border border-stone-300 px-5 py-3 font-semibold text-stone-700" %>
  </div>
<% end %>
