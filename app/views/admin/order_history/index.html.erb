<% content_for :title, "Order history | Admin" %>

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-orange-700">Administration</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight text-stone-900">Order history</h1>
    <p class="mt-2 text-stone-600">Read-only orders across all Restaurants.</p>
  </div>
  <%= link_to "Back to dashboard", admin_root_path, class: "font-semibold text-orange-700 hover:underline" %>
</div>

<%= render "shared/search_form", url: admin_order_history_path, query: @query, placeholder: "Search order ID, restaurant, driver, or status", preserve_params: request.query_parameters %>

<% if @filters_active %>
  <div class="mb-5 flex flex-wrap items-center gap-3 rounded-xl border border-orange-200 bg-orange-50 p-4 text-sm text-orange-950">
    <span>
      Filtered
      <%= " · “#{@query}”" if @query.present? %>
      <%= " · last #{@range} days" if @range %>
      <%= " · created on #{l(@created_on, format: :long)}" if @created_on %>
      <%= " · #{@status.humanize} orders" if @status %>
      <%= " · #{@delivery_status.humanize} deliveries" if @delivery_status %>
      <%= " · #{@orders.first&.restaurant&.name || Restaurant.find(@restaurant_id).name}" if @restaurant_id %>
    </span>
    <%= link_to "Clear filters", admin_order_history_path, class: "font-semibold underline" %>
  </div>
<% end %>

<% if @orders.empty? %>
  <p class="rounded-xl border border-dashed border-stone-300 bg-white p-8 text-center text-stone-600">No orders match this history view.</p>
<% else %>
  <div class="overflow-x-auto rounded-xl border border-stone-200 bg-white shadow-sm">
    <table class="w-full min-w-[900px] text-left text-sm">
      <thead class="bg-stone-100 text-xs uppercase tracking-wide text-stone-600">
        <tr>
          <th class="px-4 py-3">Order</th>
          <th class="px-4 py-3">Created</th>
          <th class="px-4 py-3">Restaurant</th>
          <th class="px-4 py-3">Customer</th>
          <th class="px-4 py-3">Kitchen status</th>
          <th class="px-4 py-3">Delivery status</th>
          <th class="px-4 py-3 text-right">Order total</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-200">
        <% @orders.each do |order| %>
          <% item_total = order.order_items.sum { |item| item.unit_price * item.quantity } %>
          <% order_total = item_total + (order.checkout_group&.delivery_fee || 0) %>
          <tr id="order-<%= order.id %>">
            <td class="whitespace-nowrap px-4 py-3 font-semibold text-stone-900">Order #<%= order.id %></td>
            <td class="whitespace-nowrap px-4 py-3 text-stone-600"><%= l(order.created_at, format: :short) %></td>
            <td class="px-4 py-3"><%= order.restaurant.name %></td>
            <td class="px-4 py-3"><%= order.customer_name.presence || order.user&.email_address || "Customer" %></td>
            <td class="px-4 py-3"><%= order.status.humanize %></td>
            <td class="px-4 py-3"><%= order.checkout_group ? order.delivery_status.humanize : "—" %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right font-semibold"><%= number_to_currency(order_total) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <nav class="mt-5 flex items-center justify-between" aria-label="Order history pages">
    <p class="text-sm text-stone-600">Page <%= @page %> of <%= @total_pages %> · <%= pluralize(@total_count, "order") %></p>
    <div class="flex gap-2">
      <% if @page > 1 %>
        <%= link_to "Previous", admin_order_history_path(@query_params.merge(page: @page - 1)), class: "rounded-lg border border-stone-300 bg-white px-4 py-2 font-semibold text-stone-800 hover:bg-stone-100" %>
      <% end %>
      <% if @page < @total_pages %>
        <%= link_to "Next", admin_order_history_path(@query_params.merge(page: @page + 1)), class: "rounded-lg border border-stone-300 bg-white px-4 py-2 font-semibold text-stone-800 hover:bg-stone-100" %>
      <% end %>
    </div>
  </nav>
<% end %>
