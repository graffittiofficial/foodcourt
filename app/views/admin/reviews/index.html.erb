<% content_for :title, "Customer reviews | Admin" %>
<h1 class="mb-6 text-3xl font-bold text-stone-900">Customer reviews</h1>

<% if @reviews.empty? %>
  <p class="rounded-2xl border border-dashed border-stone-300 p-8 text-center text-stone-600">No customer reviews have been submitted.</p>
<% else %>
  <ul class="space-y-4">
    <% @reviews.each do |review| %>
      <li class="flex flex-wrap items-start justify-between gap-4 rounded-2xl border border-stone-200 bg-white p-5">
        <div>
          <p class="font-semibold"><%= review.reviewable.name %> · <%= "★" * review.rating %><span class="text-stone-400"><%= "★" * (5 - review.rating) %></span></p>
          <p class="mt-1 text-sm text-stone-600">By <%= review.user.email_address %> · Order #<%= review.order_id %></p>
          <% if review.body.present? %><p class="mt-3 text-stone-700"><%= review.body %></p><% end %>
        </div>
        <%= button_to "Remove review", admin_review_path(review), method: :delete, class: "rounded-full border border-red-200 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50", form: { data: { turbo_confirm: "Remove this review from public display?" } } %>
      </li>
    <% end %>
  </ul>
<% end %>
