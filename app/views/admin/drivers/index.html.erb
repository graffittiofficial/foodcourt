<% content_for :title, "Drivers | Admin" %>
<div class="mb-6 flex items-center justify-between gap-4">
  <h1 class="text-3xl font-bold text-stone-900">Drivers</h1>
  <%= link_to "Create driver account", new_admin_driver_path, class: "rounded-lg bg-orange-600 px-4 py-2.5 font-semibold text-white" %>
</div>
<ul class="space-y-3">
  <% @drivers.each do |driver| %>
    <li class="rounded-xl border border-stone-200 bg-white p-5"><p class="font-semibold"><%= driver.name %></p><p class="text-sm text-stone-600"><%= driver.email_address %></p></li>
  <% end %>
</ul>
