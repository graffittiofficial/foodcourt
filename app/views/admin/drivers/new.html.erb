<% content_for :title, "Create driver | Admin" %>
<h1 class="mb-6 text-3xl font-bold text-stone-900">Create driver account</h1>
<div class="max-w-xl rounded-xl border border-stone-200 bg-white p-6">
  <% if @driver.errors.any? %><div class="mb-4 rounded-lg bg-red-50 p-4 text-red-800" role="alert"><ul class="list-inside list-disc"><% @driver.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <%= form_with model: [:admin, @driver], class: "space-y-4" do |form| %>
    <div><%= form.label :name, class: "mb-1 block font-semibold" %><%= form.text_field :name, required: true, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
    <div><%= form.label :email_address, "Email address", class: "mb-1 block font-semibold" %><%= form.email_field :email_address, required: true, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
    <div><%= form.label :password, "Temporary password", class: "mb-1 block font-semibold" %><%= form.password_field :password, required: true, minlength: 8, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
    <div><%= form.label :password_confirmation, class: "mb-1 block font-semibold" %><%= form.password_field :password_confirmation, required: true, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %></div>
    <%= form.submit "Create driver", class: "rounded-lg bg-orange-600 px-4 py-2.5 font-semibold text-white" %>
  <% end %>
</div>
<p class="mt-4 text-sm text-stone-600">Deliver the temporary password through a secure channel.</p>
