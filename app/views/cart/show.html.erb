<% content_for :title, "Your basket | Foodcourt" %>
<div class="mb-8 flex items-end justify-between gap-4">
  <h1 class="text-3xl font-bold text-stone-900">Your basket</h1>
  <%= link_to "Continue browsing", restaurants_path, class: "font-semibold text-orange-700 hover:underline" %>
</div>

<% if @entries.empty? %>
  <p class="rounded-xl border border-dashed border-stone-300 p-8 text-center text-stone-600">Your basket is empty.</p>
<% else %>
  <div class="space-y-4">
    <% @entries.each do |entry| %>
      <article class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-stone-200 bg-white p-5">
        <div>
          <% if entry.menu_item %>
            <h2 class="font-semibold text-stone-900"><%= entry.menu_item.name %></h2>
            <p class="text-sm text-stone-600"><%= entry.menu_item.restaurant.name %> · <%= number_to_currency(entry.menu_item.price) %> each</p>
          <% else %>
            <h2 class="font-semibold text-stone-900">Unavailable menu item</h2>
          <% end %>
          <% unless entry.available %><p class="mt-1 text-sm text-red-700">No longer available — remove this item to continue.</p><% end %>
        </div>
        <div class="flex items-center gap-3">
          <% if entry.available %>
            <%= form_with url: cart_item_path(entry.item_id), method: :patch, class: "flex items-center gap-2" do %>
              <%= number_field_tag :quantity, entry.quantity, min: 1, step: 1, required: true, class: "w-20 rounded-lg border border-stone-300 px-3 py-2", aria: { label: "Quantity" } %>
              <%= submit_tag "Update", class: "font-semibold text-orange-700 hover:underline" %>
            <% end %>
          <% end %>
          <%= button_to "Remove", cart_item_path(entry.item_id), method: :delete, class: "font-semibold text-stone-600 hover:underline" %>
        </div>
      </article>
    <% end %>
  </div>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-xl bg-stone-100 p-5">
    <p class="text-lg font-bold text-stone-900">Menu subtotal <%= number_to_currency(@total) %></p>
    <% if @entries.any?(&:available) && @entries.all?(&:available) %>
      <%= link_to "Continue to delivery and payment", new_checkout_path, class: "rounded-lg bg-orange-600 px-4 py-2.5 font-semibold text-white hover:bg-orange-700" %>
    <% else %>
      <span class="text-sm text-stone-600">Remove unavailable items before checkout.</span>
    <% end %>
  </div>
<% end %>
