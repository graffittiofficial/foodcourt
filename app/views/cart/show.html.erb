<% content_for :title, "Your basket | Foodcourt" %>
<div class="mb-8">
  <%= link_to "← Keep browsing", restaurants_path, class: "text-sm font-semibold text-stone-500 hover:text-stone-950" %>
  <h1 class="mt-3 text-3xl font-bold tracking-tight text-stone-950 sm:text-4xl">Your basket</h1>
  <p class="mt-2 text-stone-600"><%= @entries.sum(&:quantity) %> items from <%= @entries.filter_map { |entry| entry.menu_item&.restaurant_id }.uniq.size %> restaurants</p>
</div>

<% if @entries.empty? %>
  <section class="rounded-3xl border border-stone-200 bg-white p-10 text-center">
    <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-stone-100 text-2xl" aria-hidden="true">⌑</div>
    <h2 class="mt-4 text-xl font-bold text-stone-950">Your basket is waiting</h2>
    <p class="mt-2 text-stone-600">Browse local restaurants and add something delicious.</p>
    <%= link_to "Explore restaurants", restaurants_path, class: "mt-6 inline-flex rounded-full bg-stone-950 px-6 py-3 font-semibold text-white hover:bg-stone-700" %>
  </section>
<% else %>
  <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-5">
      <% @entries.group_by { |entry| entry.menu_item&.restaurant }.each do |restaurant, entries| %>
        <section class="overflow-hidden rounded-3xl border border-stone-200 bg-white">
          <div class="border-b border-stone-100 px-5 py-4">
            <h2 class="font-bold text-stone-950"><%= restaurant&.name || "Unavailable items" %></h2>
            <% if restaurant %>
              <%= link_to "Add more from this restaurant", restaurant_path(restaurant), class: "mt-1 text-sm font-semibold text-stone-500 hover:text-stone-950" %>
            <% end %>
          </div>
          <ul class="divide-y divide-stone-100">
            <% entries.each do |entry| %>
              <li class="flex flex-wrap items-center justify-between gap-4 p-5">
                <div class="flex min-w-0 items-center gap-3">
                  <% if entry.menu_item&.photo&.attached? %>
                    <%= image_tag entry.menu_item.photo, class: "size-16 rounded-2xl object-cover", alt: entry.menu_item.name %>
                  <% else %>
                    <div class="flex size-16 shrink-0 items-center justify-center rounded-2xl bg-stone-100 text-xl font-bold text-stone-300" aria-hidden="true"><%= entry.menu_item&.name&.first&.upcase || "?" %></div>
                  <% end %>
                  <div class="min-w-0">
                    <h3 class="truncate font-semibold text-stone-950"><%= entry.menu_item&.name || "Unavailable menu item" %></h3>
                    <% if entry.menu_item %><p class="mt-1 text-sm text-stone-500"><%= number_to_currency(entry.menu_item.price) %> each</p><% end %>
                    <% unless entry.available %><p class="mt-1 text-sm font-medium text-red-700">Unavailable — remove this item to continue.</p><% end %>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <% if entry.available %>
                    <%= form_with url: cart_item_path(entry.item_id), method: :patch, class: "flex items-center gap-2" do %>
                      <%= number_field_tag :quantity, entry.quantity, min: 1, step: 1, required: true, class: "w-16 rounded-full border border-stone-300 px-3 py-2 text-center", aria: { label: "Quantity for #{entry.menu_item.name}" } %>
                      <%= submit_tag "Update", class: "text-sm font-semibold text-stone-600 hover:text-stone-950" %>
                    <% end %>
                  <% end %>
                  <%= button_to "Remove", cart_item_path(entry.item_id), method: :delete, class: "rounded-full border border-stone-200 px-3 py-2 text-sm font-semibold text-stone-600 hover:border-stone-400 hover:text-stone-950" %>
                </div>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>

    <aside class="sticky top-6 rounded-3xl border border-stone-200 bg-white p-6">
      <h2 class="text-xl font-bold text-stone-950">Order summary</h2>
      <p class="mt-4 flex justify-between text-stone-600"><span>Items subtotal</span><span><%= number_to_currency(@total) %></span></p>
      <p class="mt-2 flex justify-between text-sm text-stone-500"><span>Delivery</span><span>Calculated at checkout</span></p>
      <p class="mt-5 flex justify-between border-t border-stone-200 pt-4 text-lg font-bold text-stone-950"><span>Subtotal</span><span><%= number_to_currency(@total) %></span></p>
      <% if @entries.all?(&:available) %>
        <%= link_to "Go to checkout", new_checkout_path, class: "mt-6 flex w-full justify-center rounded-full bg-stone-950 px-5 py-3.5 font-semibold text-white hover:bg-stone-700" %>
        <p class="mt-3 text-center text-xs text-stone-500">Delivery fees are calculated for each restaurant by distance.</p>
      <% else %>
        <p class="mt-6 rounded-2xl bg-red-50 p-4 text-sm text-red-800">Remove unavailable items before checkout.</p>
      <% end %>
    </aside>
  </div>
<% end %>
