<% content_for :title, "Your orders | Foodcourt" %>
<h1 class="mb-6 text-3xl font-bold text-stone-900">Your orders</h1>
<% if @orders.empty? %>
  <p class="rounded-xl border border-dashed border-stone-300 p-8 text-center text-stone-600">You have no orders yet. <%= link_to "Browse restaurants", restaurants_path, class: "font-semibold text-orange-700 underline" %></p>
<% else %>
  <ul class="space-y-4">
    <% @orders.each do |order| %>
      <li class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-stone-200 bg-white p-5">
        <div>
          <h2 class="font-semibold text-stone-900"><%= order.restaurant.name %> · Order #<%= order.id %></h2>
          <p class="mt-1 text-sm text-stone-600">Kitchen: <%= order.status.humanize %> · Delivery: <%= order.delivery_status.humanize %></p>
        </div>
        <div class="text-right">
          <p class="font-bold"><%= number_to_currency(order.total) %></p>
          <%= link_to "Track order", order_path(order), class: "text-sm font-semibold text-orange-700 underline" %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
