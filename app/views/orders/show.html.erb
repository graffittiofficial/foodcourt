<% content_for :title, "Order ##{@order.id} | Foodcourt" %>
<div class="mb-6">
  <%= link_to "Your orders", orders_path, class: "text-sm font-semibold text-orange-700 underline" %>
  <h1 class="mt-2 text-3xl font-bold text-stone-900"><%= @order.restaurant.name %> · Order #<%= @order.id %></h1>
  <p class="mt-2 text-stone-600">Kitchen: <%= @order.status.humanize %></p>
</div>

<section class="max-w-3xl rounded-xl border border-stone-200 bg-white p-6">
  <h2 class="text-xl font-bold text-stone-900">Delivery progress</h2>
  <ol class="mt-4 grid gap-3 sm:grid-cols-3">
    <% current_delivery_step = %w[unassigned assigned picked_up delivered].index(@order.delivery_status) %>
    <% [["assigned", "Driver assigned"], ["picked_up", "Picked up"], ["delivered", "Delivered"]].each_with_index do |(_status, label), index| %>
      <li class="rounded-lg p-3 <%= current_delivery_step > index ? "bg-emerald-50 font-semibold text-emerald-900" : "bg-stone-100 text-stone-500" %>"><%= label %></li>
    <% end %>
  </ol>
  <% if @order.driver %><p class="mt-4 text-sm text-stone-600">Your driver: <%= @order.driver.name %></p><% end %>
  <p class="mt-2 text-sm text-stone-600">Delivering to: <%= @order.checkout_group.checkout.address_line1 %>, <%= @order.checkout_group.checkout.city %> <%= @order.checkout_group.checkout.postal_code %></p>
</section>

<section class="mt-6 max-w-3xl rounded-xl border border-stone-200 bg-white p-6">
  <h2 class="text-xl font-bold text-stone-900">Items</h2>
  <ul class="mt-4 divide-y divide-stone-200">
    <% @order.order_items.includes(:menu_item).each do |item| %>
      <li class="flex justify-between gap-4 py-3">
        <span><%= item.quantity %> × <%= item.menu_item_name %></span>
        <span><%= number_to_currency(item.unit_price * item.quantity) %></span>
      </li>
    <% end %>
  </ul>
  <p class="mt-4 flex justify-between border-t border-stone-200 pt-4 font-bold"><span>Order total including delivery</span><span><%= number_to_currency(@order.total) %></span></p>
</section>
