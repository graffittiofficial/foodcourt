<% content_for :title, "Choose a Restaurant | Foodcourt" %>
<h1 class="mb-2 text-3xl font-bold">Choose a Restaurant</h1>
<p class="mb-6 text-stone-600">Choose a Restaurant assigned to you or managed by your Organization-admin membership.</p>
<ul class="space-y-3">
  <% @restaurants.each do |restaurant| %>
    <li class="flex items-center justify-between rounded-xl border border-stone-200 bg-white p-5">
      <div>
        <h2 class="font-semibold"><%= restaurant.name %></h2>
        <p class="text-sm text-stone-600"><%= restaurant.organization.name %></p>
      </div>
      <%= button_to "Manage", select_staff_restaurant_path(restaurant), method: :patch, class: "rounded-lg bg-emerald-700 px-4 py-2 font-semibold text-white" %>
    </li>
  <% end %>
</ul>
