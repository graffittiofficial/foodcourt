<% content_for :title, "Create order | Foodcourt" %>

<h1 class="mb-6 text-3xl font-bold text-stone-900">Create order</h1>
<%= form_with model: [:staff, @order], class: "max-w-3xl space-y-6" do |form| %>
  <% if @order.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 text-red-800" role="alert">
      <p class="font-semibold">Unable to create this order:</p>
      <ul class="mt-2 list-inside list-disc">
        <% @order.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>
  <div class="rounded-xl border border-stone-200 bg-white p-6">
    <%= form.label :customer_name, class: "mb-1 block font-semibold text-stone-800" %>
    <%= form.text_field :customer_name, required: true, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %>
  </div>

  <section class="rounded-xl border border-stone-200 bg-white p-6">
    <h2 class="text-lg font-bold text-stone-900">Items</h2>
    <% if @menu_items.empty? %>
      <p class="mt-3 text-stone-600">There are no available menu items. <%= link_to "Manage the menu", staff_menu_items_path, class: "font-semibold text-emerald-800 underline" %>.</p>
    <% else %>
      <ul class="mt-4 divide-y divide-stone-200">
        <% @menu_items.each do |menu_item| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-4">
            <div>
              <p class="font-semibold text-stone-900"><%= menu_item.name %></p>
              <p class="text-sm text-stone-600"><%= number_to_currency(menu_item.price) %></p>
            </div>
            <div>
              <%= hidden_field_tag "order[order_items_attributes][#{menu_item.id}][menu_item_id]", menu_item.id %>
              <%= label_tag "order_order_items_attributes_#{menu_item.id}_quantity", "Quantity", class: "sr-only" %>
              <%= number_field_tag "order[order_items_attributes][#{menu_item.id}][quantity]", 0, min: 0, step: 1, class: "w-24 rounded-lg border border-stone-300 px-3 py-2" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
  <div class="flex gap-3">
    <%= form.submit "Create order", disabled: @menu_items.empty?, class: "rounded-lg bg-emerald-700 px-4 py-2.5 font-semibold text-white disabled:cursor-not-allowed disabled:opacity-50" %>
    <%= link_to "Cancel", staff_orders_path, class: "rounded-lg border border-stone-300 px-4 py-2.5 font-semibold text-stone-700" %>
  </div>
<% end %>
