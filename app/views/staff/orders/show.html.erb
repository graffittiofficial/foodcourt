<% content_for :title, "Order ##{@order.id} | Foodcourt" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700">Order details</p>
    <h1 class="mt-1 text-3xl font-bold text-stone-900">Order #<%= @order.id %></h1>
    <p class="mt-2 text-stone-600"><%= @order.customer_name.presence || @order.user&.email_address || "Customer" %> · <%= l(@order.created_at, format: :long) %></p>
  </div>
  <span class="rounded-full bg-stone-100 px-3 py-1.5 text-sm font-semibold capitalize text-stone-800"><%= @order.status %></span>
</div>

<section class="max-w-3xl rounded-xl border border-stone-200 bg-white">
  <ul class="divide-y divide-stone-200">
    <% @order.order_items.each do |item| %>
      <li class="flex justify-between gap-4 px-5 py-4">
        <span><%= item.quantity %> × <%= item.menu_item_name %></span>
        <span class="font-semibold"><%= number_to_currency(item.unit_price * item.quantity) %></span>
      </li>
    <% end %>
  </ul>
  <p class="flex justify-between border-t border-stone-200 px-5 py-4 text-lg font-bold">
    <span>Total</span><span><%= number_to_currency(@order.total) %></span>
  </p>
</section>

<% if @order.checkout_group %>
  <% checkout = @order.checkout_group.checkout %>
  <section class="mt-6 max-w-3xl rounded-xl border border-stone-200 bg-white p-5">
    <h2 class="font-bold text-stone-900">Delivery details</h2>
    <p class="mt-2 text-stone-700"><%= checkout.customer_name %> · <%= checkout.customer_phone %></p>
    <p class="text-stone-600"><%= checkout.address_line1 %><%= ", #{checkout.address_line2}" if checkout.address_line2.present? %>, <%= checkout.city %> <%= checkout.region %> <%= checkout.postal_code %></p>
    <p class="mt-2 text-sm text-stone-600">Driver: <%= @order.driver&.name || "Not assigned" %> · Delivery: <%= @order.delivery_status.humanize %></p>
  </section>
<% end %>

<div class="mt-6 flex flex-wrap gap-3">
  <% unless @order.completed? || @order.cancelled? %>
    <%= button_to "Advance to #{ { "pending" => "preparing", "preparing" => "ready", "ready" => "completed" }.fetch(@order.status) }", advance_staff_order_path(@order), method: :patch, class: "rounded-lg bg-emerald-700 px-4 py-2.5 font-semibold text-white hover:bg-emerald-800" %>
    <%= button_to "Cancel order", cancel_staff_order_path(@order), method: :patch, class: "rounded-lg border border-red-300 px-4 py-2.5 font-semibold text-red-700", form: { data: { turbo_confirm: "Cancel this order?" } } %>
  <% end %>
  <%= link_to "Back to orders", staff_orders_path, class: "rounded-lg border border-stone-300 px-4 py-2.5 font-semibold text-stone-700" %>
</div>
