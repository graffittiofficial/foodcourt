<%= form_with model: [:staff, menu_item], class: "max-w-2xl space-y-5 rounded-xl border border-stone-200 bg-white p-6" do |form| %>
  <% if menu_item.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 text-red-800" role="alert">
      <p class="font-semibold">Please correct the following:</p>
      <ul class="mt-2 list-inside list-disc">
        <% menu_item.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= form.label :name, class: "mb-1 block font-semibold text-stone-800" %>
    <%= form.text_field :name, required: true, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %>
  </div>
  <div>
    <%= form.label :description, class: "mb-1 block font-semibold text-stone-800" %>
    <%= form.text_area :description, rows: 3, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %>
  </div>
  <div>
    <%= form.label :price, class: "mb-1 block font-semibold text-stone-800" %>
    <%= form.number_field :price, min: 0.01, step: 0.01, required: true, class: "w-full rounded-lg border border-stone-300 px-3 py-2" %>
  </div>
  <label class="flex items-center gap-2 font-medium text-stone-800">
    <%= form.check_box :available, class: "rounded border-stone-300" %>
    Available to order
  </label>
  <div class="flex gap-3">
    <%= form.submit class: "rounded-lg bg-emerald-700 px-4 py-2.5 font-semibold text-white hover:bg-emerald-800" %>
    <%= link_to "Cancel", staff_menu_items_path, class: "rounded-lg border border-stone-300 px-4 py-2.5 font-semibold text-stone-700" %>
  </div>
<% end %>
