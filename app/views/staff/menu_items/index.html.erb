<% content_for :title, "Menu | Foodcourt" %>

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700">Restaurant menu</p>
    <h1 class="mt-1 text-3xl font-bold text-stone-900">Menu items</h1>
  </div>
  <%= link_to "Add menu item", new_staff_menu_item_path, class: "rounded-lg bg-emerald-700 px-4 py-2.5 font-semibold text-white hover:bg-emerald-800" %>
</div>

<% if @menu_items.empty? %>
  <p class="rounded-xl border border-dashed border-stone-300 p-8 text-center text-stone-600">Your menu is empty. Add a menu item to get started.</p>
<% else %>
  <div class="overflow-hidden rounded-xl border border-stone-200 bg-white">
    <table class="w-full text-left text-sm">
      <thead class="bg-stone-50 text-stone-600">
        <tr>
          <th class="px-5 py-3 font-semibold">Item</th>
          <th class="px-5 py-3 font-semibold">Price</th>
          <th class="px-5 py-3 font-semibold">Availability</th>
          <th class="px-5 py-3 text-right font-semibold">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-200">
        <% @menu_items.each do |menu_item| %>
          <tr>
            <td class="px-5 py-4">
              <p class="font-semibold text-stone-900"><%= menu_item.name %></p>
              <% if menu_item.description.present? %><p class="mt-1 text-stone-600"><%= menu_item.description %></p><% end %>
            </td>
            <td class="px-5 py-4"><%= number_to_currency(menu_item.price) %></td>
            <td class="px-5 py-4"><%= menu_item.available? ? "Available" : "Unavailable" %></td>
            <td class="px-5 py-4 text-right">
              <%= link_to "Edit", edit_staff_menu_item_path(menu_item), class: "font-semibold text-emerald-800 hover:underline" %>
              <%= button_to "Archive", archive_staff_menu_item_path(menu_item), method: :patch, class: "ml-3 font-semibold text-red-700 hover:underline", form: { data: { turbo_confirm: "Archive #{menu_item.name}?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
