<% content_for :title, "#{Current.user.restaurant.name} dashboard | Foodcourt" %>

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700">Staff dashboard</p>
    <h1 class="mt-1 text-3xl font-bold text-stone-900"><%= Current.user.restaurant.name %></h1>
  </div>
  <%= link_to "Create order", new_staff_order_path, class: "rounded-lg bg-emerald-700 px-4 py-2.5 font-semibold text-white hover:bg-emerald-800" %>
</div>

<section class="grid gap-4 sm:grid-cols-3" aria-label="Today's summary">
  <article class="rounded-xl border border-stone-200 bg-white p-5">
    <p class="text-sm text-stone-600">Active orders</p>
    <p class="mt-2 text-3xl font-bold text-stone-900"><%= @active_orders_count %></p>
  </article>
  <article class="rounded-xl border border-stone-200 bg-white p-5">
    <p class="text-sm text-stone-600">Orders today</p>
    <p class="mt-2 text-3xl font-bold text-stone-900"><%= @today_orders_count %></p>
  </article>
  <article class="rounded-xl border border-stone-200 bg-white p-5">
    <p class="text-sm text-stone-600">Completed sales today</p>
    <p class="mt-2 text-3xl font-bold text-stone-900"><%= number_to_currency(@today_revenue) %></p>
  </article>
</section>

<section class="mt-10">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-xl font-bold text-stone-900">Recent orders</h2>
    <%= link_to "All orders", staff_orders_path, class: "text-sm font-semibold text-emerald-800 hover:underline" %>
  </div>
  <% if @recent_orders.empty? %>
    <p class="rounded-xl border border-dashed border-stone-300 p-8 text-center text-stone-600">No orders yet.</p>
  <% else %>
    <div class="overflow-hidden rounded-xl border border-stone-200 bg-white">
      <ul class="divide-y divide-stone-200">
        <% @recent_orders.each do |order| %>
          <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-4">
            <div>
              <%= link_to "Order ##{order.id}", staff_order_path(order), class: "font-semibold text-stone-900 hover:underline" %>
              <p class="mt-1 text-sm text-stone-600"><%= order.customer_name.presence || order.user&.email_address || "Customer" %> · <%= l(order.created_at, format: :short) %></p>
            </div>
            <div class="text-right">
              <p class="font-semibold text-stone-900"><%= number_to_currency(order.total) %></p>
              <p class="text-sm capitalize text-stone-600"><%= order.status %></p>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</section>
